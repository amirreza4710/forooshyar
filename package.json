{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "workspaces": [
    "artifacts/*",
    "lib/*",
    "scripts"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@workspace/nadraan",
    "build:nadraan": "npm run build --workspace=@workspace/nadraan",
    "build": "node -e \"if (!require('fs').existsSync('artifacts/nadraan/dist/public/index.html')) { require('child_process').execSync('npm run build:nadraan', { stdio: 'inherit' }); } else { console.log('Build output verified.'); }\"",
    "typecheck:libs": "tsc --build",
    "typecheck": "npm run typecheck:libs && npm run --workspaces --if-present typecheck",
    "test": "npm run --workspaces --if-present test",
    "graph:generate": "bash scripts/generate-graph.sh"
  },
  "private": true,
  "overrides": {
    "@esbuild-kit/esm-loader": "npm:tsx@^4.21.0",
    "esbuild": "^0.28.1",
    "tinypool": "^2.1.2",
    "body-parser": "^2.4.0",
    "undici": "^8.12.0",
    "zod": "^4.6.6",
    "glob": "^14.0.2",
    "qs": "^6.16.1",
    "minimatch": "^11.0.1",
    "postcss-selector-parser": "^7.1.6",
    "ip-address": "^10.7.4",
    "fast-uri": "^3.1.9"
  },
  "devDependencies": {
    "prettier": "^3.8.4",
    "typescript": "~5.9.3"
  },
  "pnpm": {
    "overrides": {
      "@esbuild-kit/esm-loader": "npm:tsx@^4.21.0",
      "esbuild": "^0.28.1",
      "tinypool": "^2.1.2",
      "body-parser": "^2.4.0",
      "undici": "^8.12.0",
      "zod": "^4.6.6",
      "glob": "^14.0.2",
      "qs": "^6.16.1",
      "minimatch": "^11.0.1",
      "postcss-selector-parser": "^7.1.6",
      "ip-address": "^10.7.4",
      "fast-uri": "^3.1.9"
    }
  }
}
