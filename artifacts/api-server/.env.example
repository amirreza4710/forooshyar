# کپی کن به .env و مقادیر واقعی رو جایگزین کن — .env هرگز نباید commit بشه

# پورتی که سرور روش گوش می‌ده
PORT=3000

# آدرس اتصال پستگرس
DATABASE_URL=postgres://user:password@localhost:5432/foroushyar

# رمز امضای JWT — الزامی، حداقل ۱۶ کاراکتر، تصادفی
# با این دستور یه مقدار امن بساز: openssl rand -base64 32
SESSION_SECRET=

# دامنه‌های مجاز برای CORS (با کاما جدا کنید)
# اگر خالی باشد، در محیط پروداکشن تمام درخواست‌های cross-origin مسدود می‌شود
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# اختیاری
NODE_ENV=production
LOG_LEVEL=info
